# Python
.venv/
__pycache__/
*.pyc

# Model weights (downloaded on first run — see README)
models/*.pt

# Runtime data: uploaded clips, transcode cache, logs, debug frames
data/
!data/.gitkeep

# Vendored front-end libs (loaded from CDN by default)
web/vendor/

# OS
.DS_Store
Thumbs.db

# Local launchers and dev helpers
*.bat
scripts/*
# ...except the two the README tells people to run
!scripts/sim_loop.py
!scripts/build_catalogue.py

# The browser build under docs/ IS the published site (GitHub Pages), model
# weights included -- those are the one exception to ignoring model binaries.
!docs/model/
!docs/model/*.onnx
.claude/
