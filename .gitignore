# Python
.venv/
__pycache__/
*.pyc

# Model weights (downloaded on first run — see README)
models/*.pt

# Runtime data: uploaded clips, transcode cache, logs, debug frames
data/
!data/.gitkeep

# Vendored front-end libs (loaded from CDN by default)
web/vendor/

# OS
.DS_Store
Thumbs.db

# Everything under scripts/ is part of the project: the recommender demo, the
# two consistency checks and the media pipeline that regenerates the README's
# images. A blanket scripts/* ignore silently swallowed stamp_version.py after
# the README had already started telling people to run it -- so the rule is now
# an allow-list of extensions rather than a deny-all with exceptions.
scripts/*
!scripts/*.py

# Windows launchers: small, and they are how the app actually gets started.
*.bat.local

# The browser build under docs/ IS the published site (GitHub Pages), model
# weights included -- those are the one exception to ignoring model binaries.
!docs/model/
!docs/model/*.onnx
.claude/
